---
import "../styles/global.css";
import ChatOrb from "../components/ChatOrb.astro";

const {
  title = "Terence.world",
  description = "AI-native personal notebook and portfolio for Terence Brasch.",
  chat = true,
} = Astro.props;

const pageTitle = title === "Terence.world" ? title : `${title} | Terence.world`;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const nav = [
  { href: "/start-here", label: "Start Here" },
  { href: "/projects", label: "Proof Hub" },
  { href: "/writing", label: "Writing" },
  { href: "/now", label: "Now" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f4ec" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body>
    <div class="shell">
      <header class="site-header">
        <a class="wordmark" href="/">Terence.world</a>
        <nav class="nav-row" aria-label="Primary">
          {nav.map((item) => (
            <a class="nav-link" href={item.href} aria-current={item.href === pathname ? "page" : undefined}>
              {item.label}
            </a>
          ))}
        </nav>
      </header>

      <main class="main">
        <slot />
      </main>

      <footer>
        Builder-leader proof surface. Human readable first, agent addressable by design.
      </footer>
    </div>

    {chat && <ChatOrb />}

    <script is:inline>
      const sendTelemetry = async (event, properties = {}) => {
        try {
          await fetch("/api/telemetry.json", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ event, properties }),
          });
          if (window.posthog && typeof window.posthog.capture === "function") {
            window.posthog.capture(event, properties);
          }
        } catch {
          // no-op
        }
      };

      const sessionKey = "tw.session.startedAt";
      if (!localStorage.getItem(sessionKey)) {
        localStorage.setItem(sessionKey, String(Date.now()));
      }

      const started = Number(localStorage.getItem(sessionKey) || Date.now());
      const ageMs = Date.now() - started;
      const path = window.location.pathname;
      const isProofPath = path.startsWith("/projects/") || path.startsWith("/writing/");
      const markerKey = `tw.metrics.project30.${path}`;

      if (isProofPath && ageMs <= 30000 && !sessionStorage.getItem(markerKey)) {
        sessionStorage.setItem(markerKey, "1");
        sendTelemetry("project_viewed_within_30s", { path, seconds_from_session_start: Math.round(ageMs / 1000) });
      }

      window.__twSendTelemetry = sendTelemetry;
    </script>
  </body>
</html>
