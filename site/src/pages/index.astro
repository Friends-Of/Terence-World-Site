---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";
import { sortByDateDesc, formatDate } from "../utils/content";

const projects = sortByDateDesc(await getCollection("projects")).slice(0, 3);
const writing = sortByDateDesc(await getCollection("writing")).slice(0, 4);
---

<Base title="Terence.world" description="AI-native personal notebook and portfolio for Terence Brasch.">
  <section class="panel hero">
    <div class="meta">Terence.world v1.0</div>
    <h1>Builder-leader proof, routed by intent.</h1>
    <p>
      This is a living 0->1 notebook built to make execution legible to humans and monetizable for AI agents.
      Start with intent, then follow projects, writing, and source-grounded chat.
    </p>
    <div class="pill-row">
      <span class="pill">Goal: >=65% route to proof in 30s</span>
      <span class="pill">Goal: >=18% chat engagement</span>
      <span class="pill">Goal: >=$75/mo TollBit by day 90</span>
    </div>
    <div class="pill-row">
      <a class="cta" href="/start-here">Start Here</a>
      <a class="cta" href="/projects">Open Proof Hub</a>
      <a class="cta" href="/writing">Read POV Stream</a>
    </div>
  </section>

  <section style="margin-top: 20px" class="grid grid-2">
    <article class="panel">
      <div class="meta">Flagship Projects</div>
      <h2>Recent case files</h2>
      <div class="grid">
        {projects.map((project) => (
          <a class="card card-link" href={`/projects/${project.slug}`}>
            <h3>{project.data.title}</h3>
            <p>{project.data.summary}</p>
            <p class="muted">{formatDate(project.data.publishedAt)}</p>
          </a>
        ))}
      </div>
    </article>

    <article class="panel">
      <div class="meta">Point of View</div>
      <h2>Latest writing</h2>
      <div class="grid">
        {writing.map((post) => (
          <a class="card card-link" href={`/writing/${post.slug}`}>
            <h3>{post.data.title}</h3>
            <p>{post.data.summary}</p>
            <p class="muted">{formatDate(post.data.publishedAt)}</p>
          </a>
        ))}
      </div>
    </article>
  </section>
</Base>
